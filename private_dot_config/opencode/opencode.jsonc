{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kit-toolbox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KIT Toolbox",
      "options": {
        "baseURL": "https://ki-toolbox.scc.kit.edu/api/v1",
        // "apiKey": "{env:MY_API_KEY}",
        // "headers": {
        //   "Authorization": "Bearer custom-token"
        // }
      },
      "models": {
        "kit.mistral-small-4-119b-a8b": {
          "name": "Mistral Small 4 119B A8B",
          "limit": { "context": 95232, "output": 32768 }
        },
        "kit.deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 446464, "output": 65536 }
        },
        "kit.glm-5.3": {
          "name": "GLM-5.3",
          "limit": { "context": 446464, "output": 65536 }
        }
      }
    }
  }
}
